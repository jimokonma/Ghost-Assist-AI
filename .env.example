# GhostAssist AI — Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Anthropic Claude API key
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: OpenAI API key for Whisper transcription
# Get yours at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Set to 'development' for DevTools access
NODE_ENV=production
